{
  "name": "@subculture/roberts-rules-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "format": "pnpm --filter @subculture/roberts-rules-meeting-domain build && tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js"
    ,"enrollment:issue": "tsx src/enrollment-cli.ts",
    "journal:digest": "tsx src/journal-digest-cli.ts",
    "load:fixture": "tsx src/load-fixture-cli.ts"
  },
  "dependencies": {
    "@subculture/roberts-rules-meeting-domain": "workspace:*",
    "pg": "^8.16.3",
    "ws": "^8.21.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3",
    "vitest": "^4.0.8"
  }
}
