{
  "lexicon": 1,
  "id": "tv.subcult.experimentalRuleProfile",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["profileId", "version", "name", "quorum", "debate", "voteMethods", "tiePolicy", "overrides", "effectiveFrom", "createdAt"],
        "properties": {
          "profileId": { "type": "string", "minLength": 36, "maxLength": 36 },
          "version": { "type": "integer", "minimum": 1 },
          "name": { "type": "string", "maxGraphemes": 120, "maxLength": 480 },
          "quorum": { "type": "integer", "minimum": 1 },
          "debate": { "type": "string", "maxGraphemes": 200, "maxLength": 800 },
          "voteMethods": { "type": "array", "maxLength": 20, "items": { "type": "string", "maxLength": 64 } },
          "tiePolicy": { "type": "string", "maxLength": 64 },
          "overrides": { "type": "array", "maxLength": 50, "items": { "type": "ref", "ref": "tv.subcult.experimentalRuleProfile#ruleOverride" } },
          "effectiveFrom": { "type": "string", "format": "datetime" },
          "createdAt": { "type": "string", "format": "datetime" }
        }
      }
    },
    "ruleOverride": {
      "type": "object",
      "required": ["code", "value"],
      "properties": {
        "code": { "type": "string", "minLength": 1, "maxLength": 64 },
        "value": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    }
  }
}
